{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6650a4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naveenajay337.expensetracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6650a4"
      },
      "package": "com.naveenajay337.expensetracker",
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/plain"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true
          }
        }
      ]
    ],
    "scheme": "expansetracker",
    "owner": "naveenajay337",
    "extra": {
      "eas": {
        "projectId": "c8b6de08-3060-428e-94cb-3b1bb4acae14"
      }
    }
  }
}
